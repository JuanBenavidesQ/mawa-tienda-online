# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role (SOLO servidor — API routes /api/ordenes*). Bypasea RLS: jamás
# exponerla con prefijo NEXT_PUBLIC. Desde el lockdown de RLS (2026-08-29) el
# anon key no puede tocar codigos_plan; sin esta llave la tienda NO puede
# crear órdenes.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Bold Payment Gateway
# Llave de identidad (pública) - va en el botón de pago
NEXT_PUBLIC_BOLD_API_KEY=tu-llave-de-identidad

# Llave secreta (privada) - solo servidor, para generar hash de integridad
BOLD_SECRET_KEY=tu-llave-secreta

# Medición (opcional: los IDs de producción están por defecto en src/lib/analytics.ts).
# Vaciar en ambientes de prueba para no contaminar las estadísticas reales.
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Verificación de dominio de Meta (Configuración del negocio → Dominios → etiqueta meta)
# NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
